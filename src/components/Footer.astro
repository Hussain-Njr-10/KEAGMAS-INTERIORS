<div class="marquee-container">
  <div class="marquee-content">
    <span class="marquee-text">LUXURY INTERIOR ARCHITECTURE</span>
    <span class="marquee-text">BESPOKE DESIGN</span>
    <span class="marquee-text">TIMELESS SPACES</span>
    <span class="marquee-text">CURATED ELEGANCE</span>
    
    <span class="marquee-text" aria-hidden="true">LUXURY INTERIOR ARCHITECTURE</span>
    <span class="marquee-text" aria-hidden="true">BESPOKE DESIGN</span>
    <span class="marquee-text" aria-hidden="true">TIMELESS SPACES</span>
    <span class="marquee-text" aria-hidden="true">CURATED ELEGANCE</span>
  </div>
</div>

<footer class="footer">
  <div class="footer-grid-lines">
    <div class="footer-grid-line"></div>
    <div class="footer-grid-line"></div>
    <div class="footer-grid-line"></div>
    <div class="footer-grid-line"></div>
  </div>

  <div class="container footer-inner">
    <div class="footer-cta reveal-up">
      <h2 class="font-serif italic text-accent"><a href="/contact">Let's Create Together</a></h2>
    </div>

    <div class="footer-grid reveal-up delay-1">
      <div class="footer-brand">
        <h3 class="text-uppercase font-sans">KEAGMAS INTERIORS</h3>
        <p>Luxury Interior Architecture & Design</p>
      </div>
      
      <div class="footer-links">
        <h4 class="text-uppercase font-sans">Navigation</h4>
        <a href="/projects" class="interactive">Work</a>
        <a href="/about" class="interactive">Studio</a>
        <a href="/services" class="interactive">Services</a>
        <a href="/journal" class="interactive">Journal</a>
        <a href="/contact" class="interactive">Contact</a>
      </div>
      
      <div class="footer-contact">
        <h4 class="text-uppercase font-sans">Contact</h4>
        <a href="mailto:keagmas@gmail.com" class="interactive">keagmas@gmail.com</a>
        <p>+91 98203 07991</p>
        <p>+91 22 23624313</p>
      </div>
    </div>
    
    <div class="footer-bottom text-uppercase reveal-up delay-2">
      <p>&copy; {new Date().getFullYear()} KEAGMAS INTERIORS. All Rights Reserved.</p>
      <div class="footer-legal">
        <a href="#" class="interactive">Privacy Policy</a>
        <a href="#" class="interactive">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--c-text);
    color: var(--c-white);
    padding: var(--space-2xl) 0 var(--space-md);
    position: relative;
    overflow: hidden;
  }

  .footer-grid-lines {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    display: flex;
    justify-content: space-between;
    opacity: 0.1;
  }

  .footer-grid-line {
    width: 1px;
    height: 100%;
    background-color: var(--c-white);
  }

  .footer-inner {
    position: relative;
    z-index: 1;
  }

  .footer-cta {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .footer-cta h2 {
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 1;
    margin-bottom: var(--space-lg);
  }

  .footer-cta h2 a {
    text-decoration: none;
    color: inherit;
    position: relative;
    display: inline-block;
  }
  
  .footer-cta h2 a::after {
    content: '';
    position: absolute;
    bottom: 5px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--c-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s cubic-bezier(0.7, 0, 0.3, 1);
  }
  
  .footer-cta h2 a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    margin-bottom: var(--space-md);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .footer-brand h3 {
    font-size: 1.5rem;
    letter-spacing: 0.15em;
    margin-bottom: var(--space-md);
  }

  .footer-brand p {
    font-size: 0.875rem;
    opacity: 0.7;
    max-width: 300px;
  }
  
  .footer-links h4, .footer-contact h4 {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-md);
    color: var(--c-accent);
  }

  .footer-contact p {
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    opacity: 0.8;
  }

  .footer-contact a {
    color: inherit;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    display: block;
    margin-bottom: 0.5rem;
  }

  .footer-contact a:hover {
    opacity: 1;
    color: var(--c-accent);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .footer-links a:hover {
    opacity: 1;
    color: var(--c-accent);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    justify-content: space-between;
    font-size: 0.75rem;
    opacity: 0.5;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-legal {
    display: flex;
    gap: var(--space-md);
  }
  
  .footer-legal a {
    color: inherit;
    text-decoration: none;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-inview');
        }
      });
    }, { threshold: 0.1 });

    const footerElements = document.querySelectorAll('.footer .reveal-up');
    footerElements.forEach((el) => observer.observe(el));
  });
</script>
