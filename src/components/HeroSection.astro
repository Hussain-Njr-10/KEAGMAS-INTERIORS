---
---
<section class="hero">
  <div class="hero-image-wrapper reveal-image-wrapper">
    <img src="/keagmas1/Bedrooms/Project_Renders_Grey_Beige/IMG-20260910-WA0187.jpg" alt="Luxury Interior Design Project in Mumbai by KEAGMAS INTERIORS" class="hero-image reveal-image parallax-img" data-speed="0.2" />
    <div class="hero-overlay"></div>
  </div>
  
  <div class="hero-content container">
    <h1 class="hero-title reveal-up delay-1 split-text">
      <span class="font-sans text-uppercase">Designing</span><br/>
      <span class="font-serif italic text-accent">Timeless Spaces</span>
    </h1>
    
    <div class="hero-bottom reveal-up delay-2">
      <p class="hero-subtitle">Bespoke interior architecture and luxury styling in Mumbai.</p>
      <a href="#projects" class="explore-btn interactive">
        <span class="text-uppercase">Explore Our Work</span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 4L12 20M12 20L6 14M12 20L18 14" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: flex-end;
    padding-bottom: var(--space-lg);
    overflow: hidden;
  }

  .hero-image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .hero-image {
    width: 100%;
    height: 110%; /* extra height for parallax */
    object-fit: cover;
    transform: translateY(-5%);
  }
  
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(10,10,10,0.1) 0%, rgba(10,10,10,0.6) 100%);
  }

  .hero-content {
    color: var(--c-white);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    width: 100%;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 8rem);
    line-height: 0.9;
  }

  .text-accent {
    color: #e5dfd3;
    font-weight: 400;
  }

  .hero-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-md);
    border-top: 1px solid rgba(255,255,255,0.2);
    padding-top: var(--space-md);
  }

  .hero-subtitle {
    max-width: 300px;
    font-size: 1rem;
    opacity: 0.8;
  }

  .explore-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
  }

  .explore-btn svg {
    transition: transform 0.3s ease;
  }

  .explore-btn:hover svg {
    transform: translateY(4px);
  }
</style>
