---
export interface Props {
  theme?: 'light' | 'dark';
}
const { theme = 'light' } = Astro.props;
---
<nav class={`nav ${theme === 'dark' ? 'theme-dark' : ''}`}>
  <div class="container nav-inner">
    <a href="/" class="nav-logo interactive">KEAGMAS</a>
    
    <div class="nav-links">
      <a href="/projects" class="interactive">Work</a>
      <a href="/about" class="interactive">Studio</a>
      <a href="/services" class="interactive">Services</a>
      <a href="/journal" class="interactive">Journal</a>
      <a href="/contact" class="interactive">Contact</a>
    </div>
    
    <button class="menu-btn interactive" id="mobile-menu-btn" aria-label="Toggle Menu">
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<!-- Fullscreen Mobile Menu -->
<div class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu-inner container">
    <a href="/" class="mobile-link">Home</a>
    <a href="/projects" class="mobile-link">Work</a>
    <a href="/about" class="mobile-link">Studio</a>
    <a href="/services" class="mobile-link">Services</a>
    <a href="/journal" class="mobile-link">Journal</a>
    <a href="/contact" class="mobile-link">Contact</a>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: var(--space-md) 0;
    color: var(--c-white);
    transition: background-color 0.4s ease, border-color 0.4s ease, padding 0.4s ease, color 0.4s ease;
    border-bottom: 1px solid transparent;
  }
  
  .nav.theme-dark {
    color: var(--c-text);
  }

  .nav.is-scrolled {
    background-color: rgba(249, 248, 246, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-border);
    color: var(--c-text);
    padding: var(--space-sm) 0;
  }
  
  .nav.menu-open {
    color: var(--c-text);
    background-color: transparent;
    border-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-logo {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    position: relative;
    z-index: 101;
  }

  .nav-links {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
      gap: var(--space-lg);
    }
    .nav-links a {
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      position: relative;
      overflow: hidden;
    }
    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background-color: currentColor;
      transform: translateX(-100%);
      transition: transform 0.6s cubic-bezier(0.7, 0, 0.3, 1);
    }
    .nav-links a:hover::after {
      transform: translateX(0);
    }
  }

  .menu-btn {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 10px;
    position: relative;
    z-index: 101;
  }

  .menu-btn span {
    display: block;
    width: 24px;
    height: 1px;
    background-color: currentColor;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }
  
  .menu-btn.is-active span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  
  .menu-btn.is-active span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (min-width: 768px) {
    .menu-btn {
      display: none;
    }
  }
  
  /* Mobile Menu Styles */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: var(--c-bg);
    z-index: 99;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s cubic-bezier(0.7, 0, 0.3, 1);
    display: flex;
    align-items: center;
  }
  
  .mobile-menu.is-active {
    opacity: 1;
    pointer-events: all;
  }
  
  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  
  .mobile-link {
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-family: var(--f-serif);
    font-style: italic;
    color: var(--c-text);
    text-transform: capitalize;
    transform: translateY(20px);
    opacity: 0;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.6s ease;
  }
  
  .mobile-menu.is-active .mobile-link {
    transform: translateY(0);
    opacity: 1;
  }
  
  .mobile-menu.is-active .mobile-link:nth-child(1) { transition-delay: 0.1s; }
  .mobile-menu.is-active .mobile-link:nth-child(2) { transition-delay: 0.15s; }
  .mobile-menu.is-active .mobile-link:nth-child(3) { transition-delay: 0.2s; }
  .mobile-menu.is-active .mobile-link:nth-child(4) { transition-delay: 0.25s; }
  .mobile-menu.is-active .mobile-link:nth-child(5) { transition-delay: 0.3s; }
  .mobile-menu.is-active .mobile-link:nth-child(6) { transition-delay: 0.35s; }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const nav = document.querySelector('.nav');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    
    // Scroll handling
    const handleScroll = () => {
      if (window.scrollY > 100) {
        nav?.classList.add('is-scrolled');
      } else {
        nav?.classList.remove('is-scrolled');
      }
    };
    
    window.addEventListener('scroll', handleScroll);
    handleScroll(); // init
    
    // Mobile menu toggle
    if (menuBtn && mobileMenu && nav) {
      menuBtn.addEventListener('click', () => {
        const isActive = mobileMenu.classList.contains('is-active');
        
        if (isActive) {
          mobileMenu.classList.remove('is-active');
          menuBtn.classList.remove('is-active');
          nav.classList.remove('menu-open');
          document.body.style.overflow = '';
        } else {
          mobileMenu.classList.add('is-active');
          menuBtn.classList.add('is-active');
          nav.classList.add('menu-open');
          document.body.style.overflow = 'hidden';
        }
      });
    }
  });
</script>
