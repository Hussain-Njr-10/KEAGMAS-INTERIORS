---
export interface Props {
  imageSrc: string;
}

const { imageSrc } = Astro.props;
---

<div class="sketch-background-container">
  <div class="sketch-image-wrapper">
    <img src={imageSrc} class="sketch-image" alt="" aria-hidden="true" />
  </div>
</div>

<style>
  .sketch-background-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    opacity: 0.1; /* Very subtle opacity so it doesn't overpower text */
  }

  .sketch-image-wrapper {
    width: 100%;
    height: 100%;
    /* Reveal animation from left to right */
    -webkit-mask-image: linear-gradient(to right, black 50%, transparent 50%);
    -webkit-mask-size: 200% 100%;
    -webkit-mask-position: 100% 0;
    animation: sketchReveal 3.5s cubic-bezier(0.2, 0.8, 0.2, 1) 0.3s forwards;
  }

  .sketch-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    mix-blend-mode: multiply; /* Removes white background from sketch */
  }

  @media (max-width: 768px) {
    .sketch-image {
      /* On mobile, center the image slightly differently if needed */
      object-position: center 30%; 
      /* Allow it to scale nicely without cropping the most important parts */
    }
  }

  @keyframes sketchReveal {
    0% {
      -webkit-mask-position: 100% 0;
    }
    100% {
      -webkit-mask-position: 0% 0;
    }
  }
</style>
