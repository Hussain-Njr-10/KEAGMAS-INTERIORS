---
// Testimonials.astro
---
<section class="testimonials container">
  <div class="testimonials-inner reveal-up">
    <p class="quote font-serif italic">
      "KEAGMAS transformed our penthouse into a sanctuary of calm. Their attention to materiality and light is entirely unmatched."
    </p>
    <div class="author">
      <span class="text-uppercase font-sans">A. Rossi</span>
      <span class="author-title">Malabar Hill Residence</span>
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding-bottom: var(--space-2xl);
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .testimonials-inner {
    max-width: 800px;
  }

  .quote {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    line-height: 1.3;
    margin-bottom: var(--space-md);
  }

  .author {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .author span:first-child {
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .author-title {
    font-size: 0.875rem;
    opacity: 0.6;
  }
</style>
