---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import SketchBackground from '../../components/SketchBackground.astro';

const journalEntries = await (await getCollection('journal')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout 
  title="Design Journal | Insights & Inspiration | KEAGMAS INTERIORS"
  description="Read the latest insights, thoughts, and news from KEAGMAS INTERIORS on luxury interior architecture, materiality, and spatial design in Mumbai."
>
  <Navigation />
  
  <main class="page-padding">
    <div style="position: relative; overflow: hidden; margin: -120px 0 0 0; padding: 120px 0 0 0;">
      <SketchBackground imageSrc="/keagmas1/sketches/kitchen_sketch.jpg" />
      <div class="container section-header reveal-up" style="position: relative; z-index: 1;">
      <h1 class="font-serif italic text-accent" style="font-size: clamp(3rem, 8vw, 6rem); line-height: 1.1; margin-bottom: var(--space-md);">Journal</h1>
      <p style="font-size: 1.125rem; max-width: 600px; opacity: 0.8;">Insights, thoughts, and news from the KEAGMAS studio on luxury interior architecture and bespoke design.</p>
    </div>
    </div>

    <section class="container journal-grid">
      {journalEntries.map((post, index) => (
        <a href={`/journal/${post.id}`} class={`journal-card interactive reveal-up delay-${index % 4 + 1}`}>
          <div class="journal-img-wrapper reveal-image-wrapper">
            <img src={post.data.coverImage} alt={post.data.title} class="reveal-image" />
          </div>
          <div class="journal-info">
            <div class="journal-meta text-uppercase font-sans">
              <span>{post.data.category}</span>
              <span>{post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
            </div>
            <h3 class="font-serif italic text-accent">{post.data.title}</h3>
          </div>
        </a>
      ))}
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-padding {
    padding-top: 120px;
    padding-bottom: var(--space-2xl);
  }
  
  .section-header {
    padding-top: var(--space-md);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--c-border);
    margin-bottom: var(--space-lg);
  }

  .journal-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 768px) {
    .journal-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
    }
  }

  .journal-card {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .journal-img-wrapper {
    aspect-ratio: 16/9;
    margin-bottom: var(--space-md);
    overflow: hidden;
  }

  .journal-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .journal-card:hover .journal-img-wrapper img {
    transform: scale(1.05);
  }

  .journal-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    opacity: 0.6;
    margin-bottom: var(--space-xs);
  }

  .journal-info h3 {
    font-size: 1.5rem;
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .journal-card:hover .journal-info h3 {
    color: var(--c-accent);
  }
</style>
