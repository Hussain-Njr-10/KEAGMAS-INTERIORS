---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import ServicesList from '../components/ServicesList.astro';
import ProcessGrid from '../components/ProcessGrid.astro';
import Footer from '../components/Footer.astro';
import SketchBackground from '../components/SketchBackground.astro';
---

<Layout 
  title="Interior Design Services | Bespoke Architecture Mumbai | KEAGMAS"
  description="Discover our comprehensive luxury interior architecture and design services in Mumbai. From concept to turnkey execution, we deliver bespoke residential and commercial spaces."
>
  <Navigation />
  
  <main class="page-padding">
    <div style="position: relative; overflow: hidden; margin: -120px 0 0 0; padding: 120px 0 0 0;">
      <SketchBackground imageSrc="/keagmas1/sketches/services_sketch.jpg" />
      <div class="container section-header reveal-up" style="position: relative; z-index: 1;">
      <h1 class="font-serif italic text-accent" style="font-size: clamp(3rem, 8vw, 6rem); line-height: 1.1; margin-bottom: var(--space-md);">Expertise</h1>
      <p style="font-size: 1.125rem; max-width: 600px; opacity: 0.8;">Comprehensive interior architecture and design services tailored for luxury residential and commercial environments.</p>
    </div>
    </div>

    <ServicesList />
    <ProcessGrid />
  </main>

  <Footer />
</Layout>

<style>
  .page-padding {
    padding-top: 120px;
  }
  
  .section-header {
    padding-top: var(--space-md);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--c-border);
  }
</style>
